{
    "env": {
        "browser": true,
        "es2021": true
    },
    "globals": {
        "PocketBase": "readonly",
        "Mustache": "readonly",
        "Sortable": "readonly",
        "htmx": "readonly",
        "EasyMDE": "readonly",
        "$": "readonly",
        "jQuery": "readonly",
        "PBClient": "readonly",
        "Utils": "readonly",
        "Cart": "readonly",
        "Auth": "readonly",
        "Profile": "readonly",
        "Reviews": "readonly",
        "QnA": "readonly",
        "AdminAuth": "readonly",
        "AdminOrders": "readonly",
        "AdminProducts": "readonly",
        "AdminCategories": "readonly",
        "AdminPosts": "readonly"
    },
    "parserOptions": {
        "ecmaVersion": 2021,
        "sourceType": "script"
    },
    "rules": {
        "no-unused-vars": [
            "warn",
            {
                "argsIgnorePattern": "^_"
            }
        ],
        "no-console": "off",
        "no-undef": "error",
        "semi": [
            "warn",
            "always"
        ],
        "quotes": [
            "warn",
            "single",
            {
                "avoidEscape": true,
                "allowTemplateLiterals": true
            }
        ],
        "indent": [
            "warn",
            4,
            {
                "SwitchCase": 1
            }
        ],
        "no-trailing-spaces": "warn",
        "eol-last": [
            "warn",
            "always"
        ],
        "comma-dangle": [
            "warn",
            "only-multiline"
        ],
        "no-multiple-empty-lines": [
            "warn",
            {
                "max": 2,
                "maxEOF": 1
            }
        ],
        "eqeqeq": [
            "warn",
            "smart"
        ],
        "curly": [
            "warn",
            "multi-line"
        ],
        "brace-style": [
            "warn",
            "1tbs",
            {
                "allowSingleLine": true
            }
        ],
        "keyword-spacing": "warn",
        "space-before-blocks": "warn",
        "space-infix-ops": "warn",
        "arrow-spacing": "warn",
        "no-var": "warn",
        "prefer-const": [
            "warn",
            {
                "destructuring": "all"
            }
        ]
    },
    "ignorePatterns": [
        "node_modules/",
        "public/",
        "themes/",
        "assets/js/*.min.js",
        "assets/js/pocketbase.umd.js",
        "assets/js/mustache.min.js"
    ]
}